# === Database ===
DATABASE_URL=postgresql+asyncpg://vocalflow:vocalflow@localhost:5432/vocalflow
DATABASE_URL_SYNC=postgresql://vocalflow:vocalflow@localhost:5432/vocalflow

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === S3 / MinIO ===
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_RECORDINGS_BUCKET=vocalflow-recordings

# === LiveKit ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_DOMAIN=

# === AI Providers ===
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
COHERE_API_KEY=

# === Model selection (fixed per spec, do not change casually) ===
LLM_MODEL_INCALL=claude-haiku-4-5
LLM_MODEL_POSTCALL=claude-sonnet-4-5
LLM_MODEL_JUDGE=claude-opus-4-7

# === Vector DB ===
QDRANT_URL=http://localhost:6333

# === Langfuse (self-hosted) ===
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === Auth (Clerk) ===
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Encryption (KMS or local dev) ===
ENCRYPTION_KEY=dev-32-byte-key-replace-in-prod-plz

# === Feature flags (default-off for anything that pushes latency > budget) ===
FEATURE_SEMANTIC_ENDPOINTING=true
FEATURE_VOICE_BIOMETRICS=false
FEATURE_EMOTION_ROUTING=true
FEATURE_BACKCHANNELS=true
FEATURE_FILLER_INJECTION=true

# === Latency budget (ms) — enforced by CI benchmark ===
LATENCY_P95_BUDGET_MS=500

# === Runtime ===
ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
POSTHOG_KEY=
